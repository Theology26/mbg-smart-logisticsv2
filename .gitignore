# ============================================================================
# MBG Smart Logistics — Global Monorepo Gitignore
# ============================================================================

# --- OS Specific ---
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# --- IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Environment Variables (CRITICAL) ---
.env
.env.local
.env.*.local
*.key
auth.json

# --- Database & Heavy Data ---
db-data/
osrm-data/
*.sql
*.sqlite

# --- Golang (Backend) ---
backend-golang/bin/
backend-golang/*.exe
backend-golang/backend-golang
backend-golang/vendor/

# --- Laravel & Vue (Frontend) ---
frontend-web/node_modules/
frontend-web/vendor/
frontend-web/public/build/
frontend-web/public/hot/
frontend-web/storage/*.key
frontend-web/.phpunit.result.cache

# --- React Native & Expo (Mobile) ---
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/dist/
mobile-app/npm-debug.log*

# --- Python (AI Services) ---
ai-services/__pycache__/
ai-services/*.pyc
ai-services/.ipynb_checkpoints/
ai-services/venv/
ai-services/env/
ai-services/testnota/

# --- Build Artifacts ---
dist/
build/
out/