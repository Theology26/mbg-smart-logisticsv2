# ============================================================================
# MBG Smart Logistics — Backend Golang Environment Variables
# ============================================================================

# ── Database (MySQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=mbg_admin
DB_PASSWORD=mbg_secure_2026
DB_NAME=mbg_smart_logistics

# ── OSRM (Local Docker) ────────────────────────────────────────────
OSRM_BASE_URL=http://localhost:5000

# ── AI Service (Python FastAPI) ─────────────────────────────────────
AI_SERVICE_URL=http://localhost:9000

# ── Gemini AI (Menu Recommender Only) ───────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Server ──────────────────────────────────────────────────────────
SERVER_PORT=8080
JWT_SECRET=mbg-smart-logistics-jwt-secret-change-in-production

# ── Logistics Parameters ───────────────────────────────────────────
SHELF_LIFE_BUFFER_MINUTES=30
DEFAULT_SERVICE_TIME_SECONDS=300
MAX_IMPROVEMENT_ITERATIONS=1000
